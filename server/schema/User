
const mongoose = require('mongoose');
const Schema = mongoose.Schema;

const userSchema = new Schema({

	title: {
        type: String,
        // required: true,
        unique: true
    },

	desc: {
    	type: String,
    	// required: true,
    	unique: true
	},

	priority: {
    	type: String,
    	enum: ["Low", "Medium", "High"],
    	default: "Medium"
	},

    date: {
        type: String,
        enum: ["Mon", "Tues", "Wed", "Thurs", "Fri", "Sat", "Sun"],
        default: "Mon"
    }

});

module.exports = mongoose.model("User", userSchema);
